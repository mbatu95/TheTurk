<?xml version="1.0"?>
<robot name="the_turk_pro">
<material name="graphite"><color rgba="0.055 0.065 0.080 1"/></material>
<material name="metal"><color rgba="0.42 0.46 0.52 1"/></material>
<material name="silver"><color rgba="0.72 0.75 0.79 1"/></material>
<link name="base_link"><inertial><origin xyz="0 0 0.11"/><mass value="4.8"/><inertia ixx="0.080" ixy="0" ixz="0" iyy="0.080" iyz="0" izz="0.105"/></inertial><visual><geometry><mesh filename="package://the_turk_core/meshes/base_link.stl"/></geometry><material name="graphite"/></visual><collision><origin xyz="0 0 0.12"/><geometry><cylinder radius="0.24" length="0.24"/></geometry></collision></link>
<link name="link1"><inertial><origin xyz="0 0 0.30"/><mass value="3.2"/><inertia ixx="0.110" ixy="0" ixz="0" iyy="0.095" iyz="0" izz="0.035"/></inertial><visual><geometry><mesh filename="package://the_turk_core/meshes/link1.stl"/></geometry><material name="metal"/></visual><collision><origin xyz="0 0 0.30"/><geometry><box size="0.18 0.18 0.58"/></geometry></collision></link>
<joint name="joint1" type="revolute"><parent link="base_link"/><child link="link1"/><origin xyz="0 0 0.28"/><axis xyz="0 1 0"/><limit lower="-1.5708" upper="1.5708" effort="20" velocity="1.0"/><dynamics damping="0.7" friction="0.2"/></joint>
<link name="link2"><inertial><origin xyz="0 0 0.24"/><mass value="2.1"/><inertia ixx="0.055" ixy="0" ixz="0" iyy="0.045" iyz="0" izz="0.020"/></inertial><visual><geometry><mesh filename="package://the_turk_core/meshes/link2.stl"/></geometry><material name="metal"/></visual><collision><origin xyz="0 0 0.24"/><geometry><box size="0.14 0.15 0.48"/></geometry></collision></link>
<joint name="joint2" type="revolute"><parent link="link1"/><child link="link2"/><origin xyz="0 0 0.58"/><axis xyz="0 1 0"/><limit lower="-2.0944" upper="2.0944" effort="15" velocity="1.2"/><dynamics damping="0.5" friction="0.15"/></joint>
<link name="wrist_link"><inertial><origin xyz="0 0 0.09"/><mass value="0.65"/><inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.012"/></inertial><visual><geometry><mesh filename="package://the_turk_core/meshes/wrist_link.stl"/></geometry><material name="silver"/></visual><collision><origin xyz="0 0 0.09"/><geometry><cylinder radius="0.085" length="0.20"/></geometry></collision></link>
<joint name="wrist_fixed_joint" type="fixed"><parent link="link2"/><child link="wrist_link"/><origin xyz="0 0 0.48"/></joint>
<link name="gripper_base"><inertial><origin xyz="0 0 0.055"/><mass value="0.55"/><inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.006"/></inertial><visual><geometry><mesh filename="package://the_turk_core/meshes/gripper_base.stl"/></geometry><material name="graphite"/></visual><collision><origin xyz="0 0 0.055"/><geometry><box size="0.16 0.13 0.11"/></geometry></collision></link>
<joint name="gripper_base_joint" type="fixed"><parent link="wrist_link"/><child link="gripper_base"/><origin xyz="0 0 0.19"/></joint>
<link name="left_finger"><inertial><origin xyz="0 0 0.10"/><mass value="0.16"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0002"/></inertial><visual><geometry><mesh filename="package://the_turk_core/meshes/left_finger.stl"/></geometry><material name="silver"/></visual><collision><origin xyz="0 0 0.11"/><geometry><box size="0.04 0.04 0.22"/></geometry></collision></link>
<joint name="left_finger_joint" type="fixed"><parent link="gripper_base"/><child link="left_finger"/><origin xyz="0 0.068 0.085"/></joint>
<link name="right_finger"><inertial><origin xyz="0 0 0.10"/><mass value="0.16"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0002"/></inertial><visual><geometry><mesh filename="package://the_turk_core/meshes/right_finger.stl"/></geometry><material name="silver"/></visual><collision><origin xyz="0 0 0.11"/><geometry><box size="0.04 0.04 0.22"/></geometry></collision></link>
<joint name="right_finger_joint" type="fixed"><parent link="gripper_base"/><child link="right_finger"/><origin xyz="0 -0.068 0.085"/></joint>
</robot>